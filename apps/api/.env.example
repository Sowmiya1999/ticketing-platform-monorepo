# .env

# ----------------------------------------
# Server Configuration
# ----------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/ticketing_db"
PORT=3001
NODE_ENV=development

# ----------------------------------------
# Pricing Engine Rules
# ----------------------------------------
# Time threshold (in hours) to evaluate demand shifts
THRESHOLD_TIME_FOR_DEMANDS=1


# Weight distribution for pricing algorithm
TIME_WEIGHT=0.4
DEMAND_WEIGHT=0.35
INVENTORY_WEIGHT=0.25

# Rule sets for time, demand, and inventory influence
TIME_RULES=[{"daysBefore":30,"weight":0.1},{"daysBefore":14,"weight":0.4},{"daysBefore":7,"weight":0.7},{"daysBefore":3,"weight":1.0}]
DEMAND_RULES=[{"threshold":0.3,"weight":0.2},{"threshold":0.6,"weight":0.5},{"threshold":0.8,"weight":1.0}]
INVENTORY_RULES=[{"threshold":0.8,"weight":0.2},{"threshold":0.5,"weight":0.6},{"threshold":0.3,"weight":1.0}]

